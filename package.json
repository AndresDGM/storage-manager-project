{
  "name": "storage-manager-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve showcase",
    "build": "ng build storage-manager && ng build showcase",
    "build:lib": "ng build storage-manager",
    "build:showcase": "ng build showcase",
    "watch": "ng build storage-manager --watch --configuration development",
    "test": "ng test storage-manager --watch=false",
    "test:coverage": "ng test storage-manager --watch=false --coverage",
    "test:showcase": "ng test showcase --watch=false",
    "docs": "compodoc -p tsconfig.doc.json -d documentation --silent",
    "docs:serve": "compodoc -s -d documentation"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@compodoc/compodoc": "^1.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
