{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "storage-manager": {
      "projectType": "library",
      "root": "projects/storage-manager",
      "sourceRoot": "projects/storage-manager/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/storage-manager/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/storage-manager/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/storage-manager/tsconfig.spec.json",
            "coverage": false,
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            },
            "coverageInclude": [
              "projects/storage-manager/src/lib/services/**/*.ts",
              "projects/storage-manager/src/lib/errors/**/*.ts"
            ],
            "coverageExclude": ["projects/storage-manager/src/**/*.spec.ts"]
          }
        }
      }
    }
  }
}
